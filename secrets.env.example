# Copy to secrets.env (gitignored) and fill in. Loaded by frameproof at import;
# variables already set in the shell win.
GOOGLE_API_KEY=
LLAMA_API_KEY=
SUBQ_API_KEY=
MODEL_API_KEY=             # Meta Model API (Muse Spark), https://api.meta.ai/v1
ALIBABA_API_KEY=           # Qwen via Model Studio (Token Plan by default; see config.py for other hosts)
# ANTHROPIC_API_KEY=        # or use an `ant auth login` profile

# Roles (provider:model). Get ids from `frameproof models`.
FP_IMPLEMENTER_MODEL=anthropic:claude-opus-5-5   # or alibaba:<qwen-id>, google:<id>, meta:<id>
FP_CHECKER_MODELS=meta:<llama-id>,google:<gemini-id>,subq:subq-snap-1.1
FP_JUDGE_MODEL=subq:subq-snap-1.1
# FP_AGREE_MIN=2            # checks proposed by >= 2 checkers are hard, others soft

# MongoDB Atlas memory / RAG. Keep the real URI only in secrets.env.
FP_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# FP_MONGODB_DB=frameproof
# FP_MONGODB_COLLECTION=verification_memory
# FP_MONGODB_VECTOR_INDEX=frameproof_memory
